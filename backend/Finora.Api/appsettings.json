{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Protected": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
