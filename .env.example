# Banco persistente de desenvolvimento; troque a senha por um valor local exclusivo.
POSTGRES_DB=finora_local
POSTGRES_USER=finora
POSTGRES_PASSWORD=SUBSTITUIR_POR_SENHA_LOCAL_FORTE
POSTGRES_PORT=5432

# Banco descartável dos testes; mantenha credenciais e porta independentes do banco local.
POSTGRES_TEST_DB=finora_integration_test
POSTGRES_TEST_USER=finora_test
POSTGRES_TEST_PASSWORD=SUBSTITUIR_POR_OUTRA_SENHA_LOCAL_FORTE
POSTGRES_TEST_PORT=5433
